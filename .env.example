# =============================================================================
# AI Chat Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Get these from your Supabase project dashboard:
# Project Settings > API > Project URL and anon/public key

# Your Supabase project URL
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe for browser)
# This key is read-only and protected by Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase service role key (SERVER SIDE ONLY - NEVER expose to browser)
# Used for admin operations, bypasses RLS
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION (Required)
# -----------------------------------------------------------------------------

# Google Gemini API Key for AI responses
# Get your key at: https://aistudio.google.com/apikey
# Used for: Chat responses, title generation, tool calling
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# OPTIONAL: ALTERNATIVE AI PROVIDERS
# -----------------------------------------------------------------------------

# OpenAI API Key (if using OpenAI instead of Gemini)
# OPENAI_API_KEY=sk-your-openai-key-here

# OpenRouter API Key (if using OpenRouter)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# Application URL (used for OAuth callbacks and metadata)
# Defaults to http://localhost:3000 in development
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode (automatically set by Next.js)
# NODE_ENV=development

# -----------------------------------------------------------------------------
# DEPLOYMENT PLATFORM (Optional)
# -----------------------------------------------------------------------------

# Vercel specific (automatically configured)
# VERCEL=1
# VERCEL_URL=your-deployment.vercel.app

# Netlify specific (automatically configured)
# NETLIFY=true

# -----------------------------------------------------------------------------
# ANALYTICS & MONITORING (Optional)
# -----------------------------------------------------------------------------

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# -----------------------------------------------------------------------------
# RATE LIMITING (Optional)
# -----------------------------------------------------------------------------

# Upstash Redis for rate limiting (production)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token

# =============================================================================
# SECURITY NOTES:
# =============================================================================
# 1. NEVER commit .env.local to version control
# 2. Service role keys should ONLY be used server-side
# 3. Rotate keys if they are accidentally exposed
# 4. Use environment-specific projects for dev/staging/prod
# =============================================================================
